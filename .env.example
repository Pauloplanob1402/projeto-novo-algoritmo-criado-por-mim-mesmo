# UNSAY — variáveis de ambiente
#
# ETAPA 2 (atual): configure as três variáveis do Supabase abaixo para
# ligar a persistência real. Sem elas, o app continua funcionando 100% em
# memória (comportamento da Etapa 1) — nada quebra, só não persiste nada.
#
# No Vercel, configure em Project Settings → Environment Variables.
# Nunca coloque valores reais neste arquivo — ele é só documentação/template.

# ── ETAPA 2: Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # nunca no frontend — só usada localmente pelo script de seed

# ── ETAPA 3: Autenticação ──────────────────────────────────────────────
# Não usa env vars aqui. Google OAuth é configurado direto no painel do
# Supabase (Authentication → Providers → Google, com Client ID/Secret do
# Google Cloud Console) — o app só chama supabase.auth.signInWithOAuth().
# Login por e-mail é passwordless (magic link), sem chave nenhuma.

# ── ETAPA 5: Gemini ───────────────────────────────────────────────────
# GEMINI_API_KEY=                    # server-side apenas — chamado via /api/ai/insight
