# UNSAY — variáveis de ambiente
#
# Configure tudo abaixo no Vercel: Project Settings → Environment Variables.
# Nunca coloque valores reais neste arquivo — ele é só documentação/template.
# Sem NEXT_PUBLIC_SUPABASE_URL/ANON_KEY, o app roda 100% em memória
# (comportamento da Etapa 1) — nada quebra, só não persiste nada.

# ── Supabase (Etapa 2) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada em dois lugares: localmente pelo script de seed (npm run seed) E
# em produção pela rota de exclusão de conta (app/api/account/delete),
# que precisa apagar de auth.users — algo que a anon key nunca tem
# permissão de fazer. Por isso, diferente do que dizíamos até a Etapa 6,
# ELA PRECISA estar configurada no Vercel a partir da Etapa 7. Nunca é
# exposta ao navegador (NEXT_PUBLIC_) e só é lida em Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ── Autenticação (Etapa 3) ──────────────────────────────────────────────
# Não usa env vars aqui. Google OAuth é configurado direto no painel do
# Supabase (Authentication → Providers → Google, com Client ID/Secret do
# Google Cloud Console) — o app só chama supabase.auth.signInWithOAuth().
# Login por e-mail é passwordless (magic link), sem chave nenhuma.

# ── Gemini (Etapa 5) ───────────────────────────────────────────────────
GEMINI_API_KEY=                    # server-side apenas — chamado via /api/ai/insight
# GEMINI_MODEL=gemini-2.0-flash    # opcional — troque se o nome do modelo mudar no Google AI Studio

# ── SEO / produção (Etapa 7) ────────────────────────────────────────────
# Domínio de produção, sem barra no final — usado no sitemap, robots.txt,
# Open Graph e nos links absolutos. Ex.: https://unsay.vercel.app
NEXT_PUBLIC_SITE_URL=
